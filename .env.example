# Example environment file for Alpaca producer
# Copy this to .env and fill in your actual values

# Alpaca Trading Mode - "paper" or "live"
ALPACA_TRADING_MODE=paper

# Paper Trading API Keys (start with 'PK')
ALPACA_PAPER_API_KEY=YOUR_PAPER_API_KEY_HERE
ALPACA_PAPER_API_SECRET=YOUR_PAPER_API_SECRET_HERE

# Live Trading API Keys (start with 'AK') - Only if using live mode
# ALPACA_LIVE_API_KEY=YOUR_LIVE_API_KEY_HERE
# ALPACA_LIVE_API_SECRET=YOUR_LIVE_API_SECRET_HERE
# ALPACA_LIVE_TRADING_CONFIRMED=false  # Must be "true" for live trading

# Data Feed Configuration
ALPACA_DATA_FEED=iex  # Options: iex (free), sip (paid), delayed_sip
ALPACA_USE_TEST_STREAM=false  # Set to true for FAKEPACA test symbol

# Symbols to subscribe to (comma-separated)
SYMBOLS=AAPL,MSFT,GOOGL,AMZN,NVDA  # Use FAKEPACA for testing

# Data types to subscribe to
SUBSCRIPTION_TYPES=trades,quotes,bars

# Kafka Configuration (usually don't need to change)
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_PREFIX=alpaca_market_data